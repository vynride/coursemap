# Copy to backend/.env and fill in. Never commit .env.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-hackathon-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Only when GOOGLE_GENAI_USE_VERTEXAI=false (AI Studio key fallback):
GEMINI_API_KEY=
YOUTUBE_API_KEY=
STORE=memory
MAX_VIDEOS=12
VIDEO_FPS=0.2
# DEMO=1 runs offline on a canned Docker course (no Gemini or YouTube calls, in-memory store).
DEMO=
